# Build output
build/
.gradle/
.kotlin/
*.apk
*.aab

# CMake/NDK intermediates. Regenerated by externalNativeBuild on every clean
# build, and about 50 MB of object files and JSON metadata.
.cxx/

# Local machine config: absolute SDK/NDK paths, never portable
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Downloaded Whisper weights. These live in the app's private storage on the
# phone and are fetched on first run; they are 32-190 MB and do not belong here.
*.bin

# Signing material. A *personal* release build uses the standard Android debug
# key so a sideloaded prototype installs directly. A *public* build is signed
# with the upload key generated by scripts/make-release-key.ps1, which lives
# here untracked -- along with the passwords that open it.
*.jks
*.keystore
keystore.properties
