# Build output
build/
.gradle/
.kotlin/
*.apk
*.aab

# CMake/NDK intermediates. Regenerated by externalNativeBuild on every clean
# build, and about 50 MB of object files and JSON metadata.
.cxx/

# Local machine config: absolute SDK/NDK paths, never portable
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Downloaded Whisper weights. These live in the app's private storage on the
# phone and are fetched on first run; they are 32-190 MB and do not belong here.
*.bin

# Signing material. The release build deliberately uses the standard Android
# debug key so a sideloaded prototype installs directly -- that key is generated
# locally by the SDK and must never be committed.
*.jks
*.keystore
